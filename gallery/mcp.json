    "pocketApi": 1,
    "minPocket": "0.15.0",
    "declares": {
        "extensions": ["mcp"],
        "tools": ["mcp_tools", "mcp_call", "mcp_call_read_only"],
        "readOnlyTools": ["mcp_tools", "mcp_call_read_only"],
        "hooks": [],
        "sections": ["mcp"],
        "wraps": [],
        "routes": [
            "GET state",
            "POST reload",
            "POST servers/:name/on",
            "POST servers/:name/plan-mode",
            "POST servers/:name/reconnect",
            "POST servers/:name/sign-in",
            "POST servers/:name/sign-in/paste",
            "POST servers/:name/sign-in/cancel",
            "POST servers/:name/sign-out"
        ],
        "client": "owner",
        "access": "owner"
    }
}
